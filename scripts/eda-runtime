#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"
compose_file="${repo_root}/compose.eda.yaml"
versions_file="${repo_root}/runtime/versions.env"
python_bin="${repo_root}/agent/venv/bin/python"

if [[ ! -x "${python_bin}" ]]; then
  echo "Xylon Python environment is missing: ${python_bin}" >&2
  echo "RECOVERY: create agent/venv and install requirements.lock as shown in README.md" >&2
  exit 1
fi

project_name="$(cd -- "${repo_root}" && "${python_bin}" -m agent.sandbox.runtime --project-name)"

compose() {
  docker compose \
    --project-name "${project_name}" \
    --env-file "${versions_file}" \
    -f "${compose_file}" \
    --project-directory "${repo_root}" \
    "$@"
}

case "${1:-}" in
  up)
    compose up --detach --wait
    ;;
  verify)
    cd "${repo_root}"
    "${python_bin}" -m agent.sandbox.runtime
    ;;
  status)
    compose ps
    ;;
  logs)
    compose logs --tail 200
    ;;
  down)
    compose down
    ;;
  *)
    echo "Usage: scripts/eda-runtime {up|verify|status|logs|down}" >&2
    exit 2
    ;;
esac

#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"
package_dir="${repo_root}/agent/openroad"
state_dir="${repo_root}/.xylon/openroad"
image="openroad/orfs@sha256:305f9bb42a714a37d287f9755e6f9eae1f82007a54f488a87cd663caf9900422"
python_bin="${repo_root}/agent/venv/bin/python"

if [[ ! -x "${python_bin}" ]]; then
  echo "Xylon Python environment is missing: ${python_bin}" >&2
  echo "RECOVERY: create agent/venv and install requirements.lock as shown in README.md" >&2
  exit 1
fi

resource_preflight() {
  (cd "${repo_root}" && "${python_bin}" -m agent.openroad.resource --repo "${repo_root}" --cpus 4)
}

node_pty_spawn_helper() {
  local platform_arch
  platform_arch="$(node -p '`${process.platform}-${process.arch}`')"
  printf '%s\n' "${package_dir}/node_modules/node-pty/prebuilds/${platform_arch}/spawn-helper"
}

repair_node_pty_helper() {
  local helper
  helper="$(node_pty_spawn_helper)"
  if [[ ! -f "${helper}" ]]; then
    echo "BLOCKED: node-pty spawn-helper is missing; run scripts/xylon-openroad install" >&2
    return 1
  fi
  chmod +x "${helper}"
}

doctor() {
  local node_major
  node_major="$(node --version | sed -E 's/^v([0-9]+).*/\1/')"
  if [[ -z "${node_major}" || "${node_major}" -lt 22 ]]; then
    echo "BLOCKED: Node.js 22 or newer is required" >&2
    return 1
  fi
  docker info >/dev/null
  docker image inspect "${image}" >/dev/null
  npm --prefix "${package_dir}" ls --depth=0 >/dev/null
  if [[ ! -x "$(node_pty_spawn_helper)" ]]; then
    echo "BLOCKED: node-pty spawn-helper is not executable; run scripts/xylon-openroad install" >&2
    return 1
  fi
  resource_preflight
  echo "READY: official OpenROAD-MCP and pinned OpenROAD runtime are available"
}

install_runtime() {
  npm --prefix "${package_dir}" ci
  repair_node_pty_helper
  docker pull --platform linux/amd64 "${image}"
  doctor
}

print_config() {
  node -e 'const command=process.argv[1]; console.log(JSON.stringify({mcpServers:{"xylon-openroad":{command,args:["mcp"]}}}, null, 2))' "${repo_root}/scripts/xylon-openroad"
}

run_mcp() {
  doctor >/dev/null
  mkdir -p "${state_dir}/work"
  export PATH="${repo_root}/runtime/openroad/bin:${PATH}"
  export XYLON_REPO_ROOT="${repo_root}"
  export XYLON_OPENROAD_STATE_DIR="${state_dir}"
  export XYLON_OPENROAD_IMAGE="${image}"
  export OPENROAD_ALLOWED_COMMANDS="openroad"
  export OPENROAD_ENABLE_COMMAND_VALIDATION="true"
  export OPENROAD_WHITELIST_ENABLED="true"
  export OPENROAD_MAX_SESSIONS="1"
  export OPENROAD_COMMAND_TIMEOUT="60"
  export OPENROAD_SESSION_IDLE_TIMEOUT="300"
  exec node "${package_dir}/server.mjs"
}

case "${1:-}" in
  install)
    install_runtime
    ;;
  doctor)
    doctor
    ;;
  config)
    print_config
    ;;
  mcp)
    run_mcp
    ;;
  smoke)
    doctor >/dev/null
    (cd "${repo_root}" && node "${package_dir}/smoke-client.mjs")
    ;;
  *)
    echo "Usage: scripts/xylon-openroad {install|doctor|config|mcp|smoke}" >&2
    exit 2
    ;;
esac

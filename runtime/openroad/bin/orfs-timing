#!/usr/bin/env bash
set -euo pipefail

default_image="openroad/orfs@sha256:305f9bb42a714a37d287f9755e6f9eae1f82007a54f488a87cd663caf9900422"
repo_root_input="${XYLON_REPO_ROOT:?XYLON_REPO_ROOT is required}"
run_dir_input="${XYLON_TIMING_RUN_DIR:?XYLON_TIMING_RUN_DIR is required}"
run_id="${XYLON_TIMING_RUN_ID:?XYLON_TIMING_RUN_ID is required}"
repo_id="${XYLON_TIMING_REPO_ID:?XYLON_TIMING_REPO_ID is required}"
mode="${XYLON_TIMING_MODE:-baseline}"
image="${XYLON_OPENROAD_IMAGE:-${default_image}}"
openroad_cpus="${XYLON_OPENROAD_CPUS:-1}"

identity_pattern='^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$'
image_pattern='^openroad/orfs@sha256:[a-f0-9]{64}$'

[[ "${run_id}" =~ ${identity_pattern} ]] || { echo "Invalid timing run identity" >&2; exit 2; }
[[ "${repo_id}" =~ ${identity_pattern} ]] || { echo "Invalid timing repository identity" >&2; exit 2; }
[[ "${openroad_cpus}" =~ ^[1-4]$ ]] || { echo "Invalid OpenROAD CPU budget; expected an integer from 1 to 4" >&2; exit 2; }
[[ "${image}" =~ ${image_pattern} ]] || { echo "Invalid OpenROAD image; an exact openroad/orfs sha256 digest is required" >&2; exit 2; }
[[ "${mode}" == "baseline" ]] || { echo "Unsupported timing mode: ${mode}" >&2; exit 2; }
[[ -d "${repo_root_input}" ]] || { echo "XYLON_REPO_ROOT must name an existing directory" >&2; exit 2; }
[[ -d "${run_dir_input}" ]] || { echo "XYLON_TIMING_RUN_DIR must name an existing directory" >&2; exit 2; }
[[ ! -L "${run_dir_input}" ]] || { echo "Timing run directory must not be a symbolic link" >&2; exit 2; }

repo_root="$(cd -- "${repo_root_input}" && pwd -P)"
runs_root_input="${repo_root}/.xylon/timing/runs"
[[ -d "${runs_root_input}" ]] || { echo "Timing runs root does not exist" >&2; exit 2; }
[[ ! -L "${repo_root}/.xylon" && ! -L "${repo_root}/.xylon/timing" && ! -L "${runs_root_input}" ]] || {
  echo "Timing runs root must not contain symbolic-link boundaries" >&2
  exit 2
}
runs_root="$(cd -- "${runs_root_input}" && pwd -P)"
run_dir="$(cd -- "${run_dir_input}" && pwd -P)"

[[ "${runs_root}" == "${runs_root_input}" ]] || { echo "Timing runs root escaped the repository" >&2; exit 2; }
case "${run_dir}" in
  "${runs_root}"/*) ;;
  *) echo "Timing run directory must be beneath ${runs_root}" >&2; exit 2 ;;
esac
[[ "$(basename -- "${run_dir}")" == "${run_id}" ]] || { echo "Timing run directory does not match the timing run identity" >&2; exit 2; }
[[ -f "${run_dir}/design/config.mk" ]] || { echo "Timing design config is missing" >&2; exit 2; }

cidfile="${run_dir}/container.cid"
[[ ! -e "${cidfile}" && ! -L "${cidfile}" ]] || { echo "Timing container CID file already exists; cleanup must be verified before reuse" >&2; exit 2; }

exec docker run -i \
  --cidfile "${cidfile}" \
  --label "io.xylon.owner=xylon-timing" \
  --label "io.xylon.run=${run_id}" \
  --label "io.xylon.repo=${repo_id}" \
  --platform linux/amd64 \
  --cpus "${openroad_cpus}" \
  --memory 8g \
  --memory-swap 8g \
  --pids-limit 256 \
  --ulimit nofile=1024:1024 \
  --network none \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --tmpfs /tmp:rw,noexec,nosuid,size=512m \
  --user "$(id -u):$(id -g)" \
  --env HOME=/tmp \
  --env XDG_CACHE_HOME=/tmp \
  --mount "type=bind,src=${run_dir},dst=/work" \
  --workdir /work \
  "${image}" \
  /bin/bash -lc 'source /OpenROAD-flow-scripts/env.sh && make -C /OpenROAD-flow-scripts/flow DESIGN_CONFIG=/work/design/config.mk WORK_HOME=/work FLOW_VARIANT=base grt'
